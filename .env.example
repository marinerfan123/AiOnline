# ── 服务 ──
NODE_ENV=development            # development | production
PORT=3001                       # HTTP 监听端口

# ── 会话签名密钥（auth.cjs 用 HMAC-SHA256 签 cookie JWT）──
# 生产环境务必改成随机长字符串；缺失时回退 'dev-only-change-me'（不安全）
JWT_SECRET=change-me-to-a-long-random-string

# ── PostgreSQL 主库连接 ──
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=huabu
PG_USER=postgres
PG_PASSWORD=your_postgres_password
PG_POOL_MAX=10                  # 连接池上限（高并发时调大，如 20-50）

# ── Redis（Phase 0 已启用：限流 / 缓存 / 队列）──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Phase 2 管理员账号种子（仅当库内尚无 role=admin 用户时创建）──
# 公开仓库切勿使用默认密码；部署前务必覆盖为强密码
ADMIN_SEED_EMAIL=admin@huabu.local
ADMIN_SEED_PASSWORD=Admin@123456

# ── 支付主密钥（AES-256-GCM 加密支付服务商凭据 pid/pkey/webhook_secret）──
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 必须是 32 字节（64 个 hex 字符）。缺失时支付密钥操作全部 fail-closed，不影响其余功能。
PAYMENT_MASTER_KEY=

# ── Commercial multi-node (Phase 1.5) ──
NODE_ID=api-01                  # Node identifier for logs/health (unique per API node)
WORKER_ID=worker-01             # Worker identifier (unique per worker node)
API_TOKEN=change-me-to-a-long-random-hex   # System API token (SHARED across all nodes)
ENABLE_CLUSTER=false            # Set false for multi-host (orchestrator manages instances)
PG_SSLMODE=prefer               # prefer | require | verify-full (managed PG often requires SSL)
PG_CONN_TIMEOUT_MS=5000         # PostgreSQL connection timeout
PG_IDLE_TIMEOUT_MS=30000        # PostgreSQL idle connection timeout
CORS_ORIGIN=https://yourdomain.com  # Production CORS origin
V2_PG_POOL_MAX=10               # PG pool per V2 worker
V2_GENERATION_CONCURRENCY=10    # Items processed per worker tick
V2_UPLOAD_CONCURRENCY=4         # Upload items per worker tick
V2_TICK_MS=1000                 # Worker tick interval in ms
GENERATION_V2_WORKER_ENABLED=false  # Enable V2 worker (true for worker nodes only)
