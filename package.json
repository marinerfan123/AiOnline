{
  "name": "ai-image-studio",
  "version": "0.1.0",
  "private": true,
  "bin": { "mlg": "server/cli/mlg.cjs" },
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"node server/server.js\"",
    "build": "vite build",
    "start": "node server/server.js",
    "typecheck": "tsc -p tsconfig.app.json",
    "lint": "concurrently npm:typecheck npm:lint:eslint",
    "lint:eslint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:v2": "node --test --test-concurrency=1 server/modules/generation-v2/*.test.cjs",
    "test:api": "NODE_ENV=test node --test server/tests/integration/*.test.cjs",
    "test:all": "npm run test && npm run test:v2 && npm run test:api",
    "test:quality": "node scripts/quality-gate.cjs",
    "check:syntax": "node scripts/check-server-syntax.cjs",
    "verify": "node scripts/quality-gate.cjs",
    "db:migrate:test": "NODE_ENV=test node server/db/migrate.cjs",
    "db:migrate:status": "NODE_ENV=test node server/db/migrate.cjs --status",
    "test:migration": "NODE_ENV=test node --test server/db/migration.test.cjs",
    "backup:db": "node scripts/backup-db.cjs",
    "restore:db": "node scripts/restore-db.cjs",
    "backup:verify": "node scripts/verify-backup.cjs",
    "dr:test": "NODE_ENV=test node scripts/dr-drill.cjs",
    "test:dr": "NODE_ENV=test node --test server/tests/backup/disaster-recovery.test.cjs",
    "contract:generate": "openapi-typescript contracts/openapi/moling-v2.yaml -o src/shared/api/contract/generated.d.ts",
    "contract:generate:ai-control": "openapi-typescript contracts/openapi/moling-v2-ai-control.yaml -o src/shared/api/contract/ai-control.d.ts",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build -o storybook-static",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@formkit/auto-animate": "^0.9.0",
    "@gsap/react": "^2.1.2",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-aspect-ratio": "^1.1.7",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-context-menu": "^2.2.14",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.14",
    "@radix-ui/react-hover-card": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-menubar": "^1.1.14",
    "@radix-ui/react-navigation-menu": "^1.2.13",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-scroll-area": "^1.2.8",
    "@radix-ui/react-select": "^2.1.14",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.11",
    "@radix-ui/react-toggle": "^1.1.9",
    "@radix-ui/react-toggle-group": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.1.18",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-query": "^5.102.6",
    "@xyflow/react": "^12.11.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "embla-carousel-react": "^8.6.0",
    "express": "^4.21.0",
    "framer-motion": "^12.38.0",
    "gsap": "^3.15.0",
    "input-otp": "^1.4.2",
    "ioredis": "^6.0.0",
    "lucide-react": "0.577.0",
    "next-themes": "^0.4.6",
    "pg": "^8.13.0",
    "react": "^19.2.4",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.4",
    "react-error-boundary": "^6.0.0",
    "react-hook-form": "^7.72.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^3.0.6",
    "react-router-dom": "^7.18.2",
    "recharts": "^2.15.4",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.2.0",
    "vaul": "^1.1.2",
    "zod": "^4.3.6",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@lark-apaas/coding-presets-react": "^0.1.0",
    "@playwright/test": "^1.62.1",
    "@storybook/react-vite": "^10.5.10",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^9",
    "eslint": "^9",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.13.0",
    "storybook": "^10.5.10",
    "typescript": "~5.9",
    "vite": "^8",
    "vitest": "^3.2.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
